# ─── Rota Vital — Variáveis de Ambiente de Exemplo (.env.example) ───
# Copie este arquivo para .env na raiz do projeto para personalizar valores locais.

# Porta externa exposta pela API
PORT=8080

# Credenciais e parâmetros do banco de dados PostgreSQL
POSTGRES_DB=rotavital
POSTGRES_USER=rotavital
POSTGRES_PASSWORD=rotavital_secret
POSTGRES_PORT=5432

# Credenciais do DataSource Spring (perfil infra)
# No Docker Compose, a URL padrão conecta diretamente ao container 'db' (jdbc:postgresql://db:5432/${POSTGRES_DB}).
# Descomente a linha abaixo apenas para execuções no host fora do Compose (ex: mvn spring-boot:run):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rotavital
SPRING_DATASOURCE_USERNAME=rotavital
SPRING_DATASOURCE_PASSWORD=rotavital_secret

# Configurações de JVM / JAVA_OPTS para o container da aplicação
JAVA_OPTS=-Xms256m -Xmx512m
